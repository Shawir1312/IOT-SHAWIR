# ShawirIOT .gitignore

# Dependencies
/websocket/vendor/

# Local installation lock (let users run installer upon clone)
installed.lock

# Operating System Files
.DS_Store
Thumbs.db

# IDE / Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads
/uploads/*
!/uploads/.gitkeep
